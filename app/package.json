{
  "name": "claude-clone",
  "version": "0.1.0",
  "description": "Local Claude-style chat (Groq + PostgreSQL)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "keywords": [],
  "author": "local",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dompurify": "^3.4.18",
    "embedded-postgres": "^18.6.0-beta.19",
    "express": "^5.3.0",
    "marked": "^18.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@45.3.3": true
  },
  "productName": "Claude Clone",
  "build": {
    "appId": "local.claudeclone",
    "productName": "Claude Clone",
    "files": [
      "main.js",
      "server.js",
      "public/**",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/@embedded-postgres/**",
      "node_modules/embedded-postgres/**"
    ],
    "extraResources": [
      {
        "from": "../.env",
        "to": ".env"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "dist"
    }
  }
}